# Local development and manual Liquibase use only. The API does not load this
# file itself; export its values in your shell. Never deploy this file to EKS.
# Copy this file to database/.env and replace the placeholders.
# Quote values containing spaces or shell-special characters.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=faculty_db
DB_USER=your_database_user
DB_PASS=replace_with_database_password
DB_DIALECT=mysql
JWT_SECRET=replace_with_a_long_random_secret
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY_MS=1000
DB_CONNECT_RETRY_MAX_DELAY_MS=8000
DB_SSL=false
# If DB_SSL=true, set this to the mounted/downloaded RDS CA bundle path.
# DB_SSL_CA_PATH=/path/to/global-bundle.pem
# Set CORS_ORIGINS only if the frontend uses a different origin.
CORS_ORIGINS=

